#include <stdio.h>
#include "platform.h"
#include "xil_printf.h"
#include "xil_io.h"
#include "xparameters.h"
#include "xuartps_hw.h"  // For PS UART keyboard input

#ifndef ACCEL_BASEADDR
#define ACCEL_BASEADDR XPAR_TOP_SYSTEM_LEVEL_0_BASEADDR
#endif

#define REG0_CTRL_OFFSET    0x00  // Multiplier Scalar Y
#define REG1_DATA_OFFSET    0x04  // Stream Input Byte X
#define REG2_STATUS_OFFSET  0x08  // Status Readback

int main()
{
    init_platform();

    xil_printf("\r\n===========================================\r\n");
    xil_printf("   PS-PL Hardware MAC Accelerator Driver   \r\n");
    xil_printf("===========================================\r\n\r\n");

    // 1. Set Multiplier Scalar Y = 5
    u32 scalar_y = 5;
    Xil_Out32(ACCEL_BASEADDR + REG0_CTRL_OFFSET, scalar_y);
    xil_printf("[PS] Set MAC Multiplier Scalar Y = %d\r\n", scalar_y);
    xil_printf("[PS] Type any character in PuTTY to run MAC calculation...\r\n\r\n");

    while(1) {
        // Check if user typed a key in PuTTY
        if (XUartPs_IsReceiveData(STDIN_BASEADDRESS)) {
            u8 input_char = XUartPs_ReadReg(STDIN_BASEADDRESS, XUARTPS_FIFO_OFFSET);

            xil_printf("[PS] Received key: '%c' (ASCII %d)\r\n", input_char, input_char);

            // Write input byte to PL over AXI
            Xil_Out32(ACCEL_BASEADDR + REG1_DATA_OFFSET, (u32)input_char);

            // Read FSM status from PL
            u32 status = Xil_In32(ACCEL_BASEADDR + REG2_STATUS_OFFSET) & 0x03;
            xil_printf("[PL Status] Current State: %d\r\n\r\n", status);
        }
    }

    cleanup_platform();
    return 0;
}
