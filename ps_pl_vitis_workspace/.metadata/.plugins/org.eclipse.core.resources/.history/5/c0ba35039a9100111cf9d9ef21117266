    xil_printf("  [M] Calculate Single Integer Input (AXI-Lite)\r\n");
    xil_printf("  [V] Run AXI-Lite MMIO Loop Benchmark (N = 1024)\r\n");
    xil_printf("  [D] Run AXI DMA Stream Hardware Benchmark (N = 1024)\r\n");
    xil_printf("  [S] Change Scalar Multiplier (Y)\r\n");
    xil_printf("  [H] Reprint Menu\r\n");
    xil_printf("  [Q] Exit Application\r\n");
    xil_printf("===================================================\r\n\r\n");
}

int main()
{
    init_platform();

    xil_printf("\r\n===================================================\r\n");
    xil_printf("[SYSTEM HARDWARE ADDRESS MAP]\r\n");
    xil_printf(" Accelerator Base Address : 0x%08X\r\n", ACCEL_BASEADDR);
    xil_printf("===================================================\r\n");

    xil_printf("\r\nInitializing AXI DMA Engine...\r\n");
    if (init_dma() == XST_SUCCESS) {
        xil_printf("[SYSTEM] AXI DMA Engine Initialized Successfully!\r\n");
        xil_printf("[SYSTEM] DMA Active Base Address: 0x%08X\r\n", AxiDma.RegBase);
    } else {
        xil_printf("[SYSTEM ERROR] AXI DMA Initialization Failed!\r\n");
    }

    xil_printf("\r\nEnter initial MAC Scalar Multiplier Y: ");
    u32 scalar_y = get_int_from_uart();

    Xil_Out32(ACCEL_BASEADDR + REG0_CTRL_OFFSET, scalar_y);
    print_menu(scalar_y);

    int running = 1;

    while(running) {
        if (XUartPs_IsReceiveData(STDIN_BASEADDRESS)) {
            u8 key = XUartPs_ReadReg(STDIN_BASEADDRESS, XUARTPS_FIFO_OFFSET);

            if (key == '\r' || key == '\n') continue;

            switch (key) {
                case 'M':
                case 'm':
                    xil_printf("\r\nEnter Integer X: ");
                    u32 custom_x = get_int_from_uart();
                    run_mac_calculation(custom_x, scalar_y);
                    break;

                case 'V':
                case 'v':
                    run_vector_benchmark(scalar_y);
                    break;

                case 'D':
                case 'd':
                    run_dma_stream_benchmark(scalar_y);
                    break;

                case 'S':
                case 's':
                    xil_printf("\r\nEnter NEW Scalar Y: ");
                    scalar_y = get_int_from_uart();
                    Xil_Out32(ACCEL_BASEADDR + REG0_CTRL_OFFSET, scalar_y);
                    xil_printf("[CONFIG] Updated Scalar Y = %d\r\n\r\n", scalar_y);
                    break;

                case 'H':
                case 'h':
                    print_menu(scalar_y);
                    break;

                case 'Q':
                case 'q':
                    xil_printf("\r\nExiting application. Goodbye!\r\n");
                    running = 0;
                    break;

                default:
                    xil_printf("[NOTICE] Invalid key '%c'. Press 'H' for options.\r\n", key);
                    break;
            }
        }
    }

    cleanup_platform();
    return 0;
}
