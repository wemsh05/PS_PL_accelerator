#include <stdio.h>
#include "platform.h"
#include "xil_printf.h"
#include "xil_io.h"
#include "xparameters.h"

// Set base address from xparameters.h (or fallback if undefined)
#ifndef ACCEL_BASEADDR
#define ACCEL_BASEADDR XPAR_TOP_SYSTEM_LEVEL_0_BASEADDR
#endif

#define REG0_CTRL_OFFSET    0x00  // Multiplier Scalar Y [15:0]
#define REG2_STATUS_OFFSET  0x08  // Accelerator FSM Status Readback

int main()
{
    init_platform();

    xil_printf("\r\n===========================================\r\n");
    xil_printf("   PS-PL Hardware MAC Accelerator Driver   \r\n");
    xil_printf("===========================================\r\n\r\n");

    // 1. Configure the MAC Multiplier Scalar Y
    u32 scalar_y = 5; // Example scalar factor: multiplies streamed bytes by 5
    xil_printf("[PS] Setting MAC Multiplier Scalar Y = %d...\r\n", scalar_y);
    Xil_Out32(ACCEL_BASEADDR + REG0_CTRL_OFFSET, scalar_y);

    // Verify write
    u32 read_y = Xil_In32(ACCEL_BASEADDR + REG0_CTRL_OFFSET) & 0xFFFF;
    xil_printf("[PS] Verified REG0 Multiplier Y = %d\r\n\r\n", read_y);

    // 2. Read Initial Status
    u32 status = Xil_In32(ACCEL_BASEADDR + REG2_STATUS_OFFSET) & 0x03;
    xil_printf("[PS] Initial Accelerator State: ");
    if (status == 0)      xil_printf("IDLE\r\n");
    else if (status == 1) xil_printf("PROCESSING\r\n");
    else                  xil_printf("DONE\r\n");

    xil_printf("[PS] Ready! Stream bytes via UART terminal to run MAC hardware pipeline.\r\n\r\n");

    // 3. Live FSM Status Monitoring Loop
    u32 last_status = status;
    while(1) {
        status = Xil_In32(ACCEL_BASEADDR + REG2_STATUS_OFFSET) & 0x03;

        // Print live updates whenever the PL accelerator state changes
        if (status != last_status) {
            if (status == 0) {
                xil_printf("[PL Event] State -> IDLE (Ready for next byte)\r\n");
            } else if (status == 1) {
                xil_printf("[PL Event] State -> PROCESSING (Data in MAC pipeline)\r\n");
            } else if (status == 2) {
                xil_printf("[PL Event] State -> DONE (Result computed & transmitted)\r\n");
            }
            last_status = status;
        }
    }

    cleanup_platform();
    return 0;
}
